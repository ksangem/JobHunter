# auth-service env (subset of root .env.example)
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://jobhunter:jobhunter@localhost:5432/jobhunter?schema=public
REDIS_URL=redis://localhost:6379

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=jobhunter-auth

# RS256 keys (generate: openssl genpkey -algorithm RSA -out jwt-private.pem ...)
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL=600

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/google/callback
OAUTH_SUCCESS_REDIRECT=jobhunter://auth/callback
