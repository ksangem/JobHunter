# ============================================================================
# JobHunter — Environment Template (Tech Specs §12.3)
# Copy to .env and fill. NEVER commit real secrets (AWS Secrets Manager in prod).
# ============================================================================

# --- Core ---
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug

# --- Database (PostgreSQL 16, RLS enabled) ---
DATABASE_URL=postgresql://jobhunter:jobhunter@localhost:5432/jobhunter?schema=public
PGBOUNCER_URL=postgresql://jobhunter:jobhunter@localhost:6432/jobhunter

# --- Redis (sessions, rate limits, OTP, denylist) ---
REDIS_URL=redis://localhost:6379

# --- Kafka (event bus, partition by org_id) ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=jobhunter

# --- Object storage (S3 / MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=jobhunter-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Temporal (CV parse, GDPR erasure workflows) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Auth (RS256 JWT) ---
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
OTP_TTL=600

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- AI / LLM (primary Claude per G-023, OpenAI fallback) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# --- Vector DB ---
PINECONE_API_KEY=
PINECONE_INDEX=jobhunter-candidates
PINECONE_ENVIRONMENT=us-east-1

# --- Voice AI ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RETELL_API_KEY=
DEEPGRAM_API_KEY=

# --- Email ---
SES_REGION=ap-south-1
SENDGRID_API_KEY=

# --- Compliance ---
TRAI_DNC_API_KEY=

# --- Push notifications ---
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# --- Frontend (Expo public env — prefix EXPO_PUBLIC_) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:3009
# Toggle the in-app mock data layer (true = runs with no backend; see apps/mobile/lib/api-client.ts)
EXPO_PUBLIC_USE_MOCKS=true
