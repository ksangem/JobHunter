{
  "expo": {
    "name": "JobHunter",
    "slug": "jobhunter",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "jobhunter",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1F44"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobhunter.app"
    },
    "android": {
      "package": "com.jobhunter.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A1F44"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
