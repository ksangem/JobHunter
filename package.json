{
  "name": "jobhunter",
  "version": "2.0.0",
  "private": true,
  "description": "JobHunter — AI-powered, multi-tenant recruitment ecosystem (universal web + mobile)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20 <=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "web": "turbo run web --filter=@jobhunter/mobile",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "rimraf": "^6.0.1",
    "prettier": "^3.3.3"
  }
}
